class Solution(object):
    def largestRectangleArea(self, heights):
         maxi = 0
         n = len(heights)
         for i in range(n):
            minimum = heights[i]
            for j in range(i, n):
                minimum = min(minimum, heights[j])
                area = minimum * (j - i + 1)
                maxi = max(maxi, area)
         return maxi
